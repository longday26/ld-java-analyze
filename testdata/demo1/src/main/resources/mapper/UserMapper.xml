<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="demo.UserMapper">
    <select id="selectById" resultType="demo.User">
        SELECT name, active FROM user WHERE id = #{id}
    </select>
    <insert id="insert" parameterType="demo.User">
        INSERT INTO user (name, active) VALUES (#{name}, #{active})
    </insert>
</mapper>
